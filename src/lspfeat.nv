// fn main() [io]
//     println("${lspfeat.doc_position("file:///a.nv", lspbase.position(1, 1)).position.line}")
// ```
pub fn doc_position(uri: Str, p: lspbase.LspPosition) -> LspDocPosition []
    todo("lsp-nv.lspfeat.doc_position")

