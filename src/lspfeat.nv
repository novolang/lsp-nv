// use lspbase
// use lspfeat
//
// fn main() [io]
//     let r = lspbase.at(lspbase.position(0, 0))
//     println(lspfeat.completion("x", LspKindVariable, r, "x").label)
// ```
pub fn completion(label: Str, kind: LspCompletionKind, r: lspbase.LspRange,
                  insert: Str) -> LspCompletionItem []
    todo("lsp-nv.lspfeat.completion")

// A completion list.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println("${list.len(lspfeat.completion_list([], false).items)}")
// ```
pub fn completion_list(items: [LspCompletionItem], is_incomplete: Bool) -> LspCompletionList []
    todo("lsp-nv.lspfeat.completion_list")

// The number a completion kind has on the wire.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println(lspfeat.completion_kind_code(LspKindMethod))   // 2
// ```
pub fn completion_kind_code(k: LspCompletionKind) -> Int []
    todo("lsp-nv.lspfeat.completion_kind_code")

// The completion kind a wire number denotes, or `None` — including for
// the seventeen the specification defines and this package does not
// carry.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     match lspfeat.completion_kind_of(3)
//         None    => println("not one this package carries")
//         Some(_) => println("a function")
// ```
pub fn completion_kind_of(code: Int) -> ?LspCompletionKind []
    todo("lsp-nv.lspfeat.completion_kind_of")

// A hover.
//
// ```novo
// use lspbase
// use lspfeat
//
// fn main() [io]
//     let m = lspbase.markup(LspPlainText, "Int")
//     println(lspfeat.hover(m, lspbase.at(lspbase.position(0, 0))).contents.value)
// ```
pub fn hover(contents: lspbase.LspMarkupContent, r: lspbase.LspRange) -> LspHover []
    todo("lsp-nv.lspfeat.hover")

// A rename target.
//
// ```novo
// use lspbase
// use lspfeat
//
// fn main() [io]
//     println(lspfeat.rename_target(lspbase.at(lspbase.position(0, 0)), "x").placeholder)
// ```
pub fn rename_target(r: lspbase.LspRange, placeholder: Str) -> LspRenameTarget []
    todo("lsp-nv.lspfeat.rename_target")

// A semantic token with absolute coordinates.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println("${lspfeat.token(2, 0, 5, 0, 0).line}")        // 2
// ```
pub fn token(line: Int, start: Int, length: Int, token_type: Int,
             modifiers: Int) -> LspSemanticToken []
    todo("lsp-nv.lspfeat.token")

// A legend.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println("${list.len(lspfeat.legend([], []).token_modifiers)}")
// ```
pub fn legend(token_types: [Str], token_modifiers: [Str]) -> LspSemanticLegend []
    todo("lsp-nv.lspfeat.legend")

// Absolute tokens as the flat delta-encoded array the wire carries.
//
// THE ENCODING EVERY SERVER GETS WRONG ONCE.  Five integers per token:
// the line delta from the previous token; the character delta, which is
// from the previous token's START when they are on the same line and
// from the LINE start when they are not; the length; the type index;
// the modifier bitset.
//
// The input must be sorted by line and then by start.  This function
// sorts it, because an unsorted array produces silently wrong colours
// rather than an error, and a server that forgot to sort has a bug that
// appears only in files whose declarations are out of order.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println("${list.len(lspfeat.encode_tokens([lspfeat.token(0, 0, 3, 0, 0)]))}")
// ```
pub fn encode_tokens(tokens: [LspSemanticToken]) -> [Int] []
    todo("lsp-nv.lspfeat.encode_tokens")

// The flat wire array back as absolute tokens.
//
// For a client, and for a server's own tests — asserting on a delta
// array by eye is how a wrong base goes unnoticed.
//
// `None` when the array's length is not a multiple of five, which is
// the only way it can be malformed.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     match lspfeat.decode_tokens([0, 0, 3, 0, 0])
//         None     => println("not a token array")
//         Some(ts) => println("${list.len(ts)}")            // 1
// ```
pub fn decode_tokens(data: [Int]) -> ?[LspSemanticToken] []
    todo("lsp-nv.lspfeat.decode_tokens")

// Formatting options.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println("${lspfeat.formatting_options(2, true).insert_spaces}")
// ```
pub fn formatting_options(tab_size: Int, insert_spaces: Bool) -> LspFormattingOptions []
    todo("lsp-nv.lspfeat.formatting_options")

// The single edit that replaces a whole document with formatted text.
//
// What a formatter answers, and the shape that avoids a whole class of
// bug: a formatter returning many small edits has to get every range
// right against the unformatted text, and one wrong range corrupts the
// file.  One edit over the whole document cannot be wrong, at the cost
// of losing the cursor position — which clients restore themselves.
//
// The `line_count` is the document's, because the edit's end must be
// the position after its last line.
//
// ```novo
// use lspfeat
//
// fn main() [io]
//     println(lspfeat.whole_document_edit(3, "x\n").new_text)   // x
// ```
pub fn whole_document_edit(line_count: Int, formatted: Str) -> lspbase.LspTextEdit []
    todo("lsp-nv.lspfeat.whole_document_edit")
